# Copy this file to .env and fill in your values. Never commit .env.
DISCORD_TOKEN=
CLIENT_ID=
# Optional: Groq key powers chat banter and natural-language admin commands
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Name the server is built around (used in channel names, welcome text, etc.)
BRAND_NAME=Brand
# Timezone for scheduled posts (hot takes, question of the day)
TIMEZONE=Asia/Kolkata
